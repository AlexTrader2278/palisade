# Скопируй в .env.local и подставь ключи. .env.local в .gitignore.

# Supabase — проект palisade-sergey (та же база тредов).
# Только anon/publishable ключ! service_role публичному сервису не нужен.
SUPABASE_URL=https://fqzasnqpqxmrsssmcnuy.supabase.co
SUPABASE_ANON_KEY=

# Mistral — embeddings (mistral-embed) для семантического поиска.
MISTRAL_API_KEY=

# OpenRouter — AI-суммаризация находок (по кнопке). Без него работает только поиск.
OPENROUTER_API_KEY=
AI_MODEL=openai/gpt-4o-mini

# Необязательно (локалка на Windows): "curl" обходит TLS-fingerprint Cloudflare.
# HTTP_FORCE=curl
